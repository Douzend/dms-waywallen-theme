{
	"id": "waywallenTheme",
	"name": "Waywallen Theme Sync",
	"description": "Syncs DMS colors with your Waywallen wallpaper · Sincroniza los colores de DMS con el fondo de Waywallen",
	"version": "0.1.0",
	"author": "Douzend",
	"type": "daemon",
	"capabilities": ["daemon"],
	"icon": "wallpaper",
	"component": "./WaywallenThemeDaemon.qml",
	"settings": "./WaywallenThemeSettings.qml",
	"startupCheck": "./StartupCheck.qml",
	"permissions": ["settings_read", "settings_write", "process"],
	"dependencies": ["ffmpeg", "sqlite3"],
	"requires_dms": ">=1.6.0"
}
